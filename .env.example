# OCIO Portal - example environment configuration
# Copy to .env and adjust as needed. No real secrets belong here.

# --- Backend (FastAPI) ---
OCIO_ENV=local
OCIO_DATABASE_URL=sqlite:///./ocio_portal.db
OCIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OCIO_SEED_ON_STARTUP=true
OCIO_LOG_LEVEL=INFO

# Placeholder identity provider settings (LocalDevAuthAdapter does not use these).
# When swapping in Entra ID, populate a real .env (never committed) with values below.
OCIO_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
OCIO_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
OCIO_ENTRA_CLIENT_SECRET=changeme-placeholder

# Placeholder Power BI settings (PlaceholderPowerBIAdapter does not call out to Power BI).
OCIO_POWERBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
OCIO_POWERBI_TENANT_ID=00000000-0000-0000-0000-000000000000
OCIO_POWERBI_CLIENT_ID=00000000-0000-0000-0000-000000000000
OCIO_POWERBI_CLIENT_SECRET=changeme-placeholder

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="OCIO Portal"
VITE_POWERBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
VITE_POWERBI_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Set to true to hide the "Local Prototype Mode" / "Demonstration Data" pills and
# banners (e.g. for screenshots/demos). Also settable via start.ps1 -HideDemoLabels.
VITE_HIDE_DEMO_LABELS=false
